<!DOCTYPE html>
<html lang="en">
<head>
  <title>David Laganière</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#0059b3">
  <meta name="Description" content="Front page of David Laganière.">
  <meta charset="UTF-8">
  {% css %}
  @font-face {
    font-family: 'Mona Sans';
    font-style: normal;
    font-weight: 100 900;
    font-display: swap;
    src: url('/fonts/MonaSans-subset.woff2') format('woff2');
  }
  @font-face {
    font-family: 'Mona Sans Mono';
    font-style: normal;
    font-weight: 100 900;
    font-display: swap;
    src: url('/fonts/MonaSansMonoVF[wdth,wght].woff2') format('woff2');
  }

  @font-face {
    font-family: 'Mona Sans fallback';
    src: local('Arial'), local('Helvetica Neue'), local('Helvetica'), local('sans-serif');
    ascent-override: 109%;
    descent-override: 32%;
    line-gap-override: 0%;
  }

  body {
    background: #f3f4f6;
    font-family: 'Mona Sans', 'Mona Sans fallback', sans-serif;
    margin: 0;
    padding: 0;
  }

  .page {
    max-width: 600px;
    margin: 0 auto;
    padding: 40px 20px;
  }

  nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #f3f4f6;
    border-radius: 8px;
    padding: 10px 16px;
    margin-bottom: 16px;
  }

  .nav-links {
    display: flex;
    gap: 16px;
  }

  .nav-links a {
    text-decoration: none;
    color: #000000;
    font-size: 15px;
    font-weight: 500;
  }

  .nav-links a:hover {
    text-decoration: underline;
    text-decoration-color: #2d0589;
    text-decoration-thickness: 3px;
    text-underline-offset: 4px;
  }

  .nav-icons {
    display: flex;
    gap: 12px;
    align-items: center;
  }

  .nav-icons a {
    display: flex;
    align-items: center;
    padding-bottom: 3px;
    border-bottom: 3px solid transparent;
  }

  .nav-icons a:hover {
    border-bottom-color: #2d0589;
  }

  .nav-icon {
    height: 22px;
    width: 22px;
  }

  .nav-icon path {
    fill: #000000;
  }

  header {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 24px;
    background: #f3f4f6;
    border-radius: 8px;
    padding: 24px;
    margin-bottom: 16px;
  }

  .header-text {
    text-align: left;
  }

  .header-text h1 {
    font-size: 25px;
    font-weight: bold;
    margin: 0 0 5px 0;
    color: #000000;
    border-bottom: 4px solid #2d0589;
    padding-bottom: 0;
  }

  .header-text h2 {
    font-size: 15px;
    font-weight: normal;
    margin: 0;
    color: #333333;
  }

  .photo {
    width: 150px;
    height: 150px;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    object-fit: cover;
  }

  .about {
    text-align: left;
    font-weight: 300;
    color: #000000;
    line-height: 1.6;
    background: #f3f4f6;
    border-radius: 8px;
    padding: 25px;
  }

  .link-text {
    border: 0;
    padding: 0;
    margin: 0;
    position: absolute !important;
    height: 1px;
    width: 1px;
    overflow: hidden;
  }

  @media screen and (max-width: 420px) {
    .header-text h1 {
      font-size: 20px;
    }

    .header-text h2 {
      font-size: 13px;
    }

    .photo {
      width: 120px;
      height: 120px;
    }

    .nav-icon {
      height: 26px;
      width: 26px;
    }
  }
  {% endcss %}
  <link rel="preload" href="/fonts/MonaSans-subset.woff2" as="font" type="font/woff2" crossorigin>
  <style>{% getBundle "css" %}</style>
  <script async src="https://umami.davidlaganiere.com/script.js" data-website-id="055c750c-8baf-41a7-af1e-82e3925dab5e"></script>
</head>
<body>
  <div class="page">
    <nav>
      <div class="nav-links">
        <a href="/">Home</a>
        <a href="/blog">Blog</a>
      </div>
      <div class="nav-icons">
        <a href="https://ca.linkedin.com/in/david-lagani%C3%A8re-ing-p-eng-5a22ab4" target="_blank">
