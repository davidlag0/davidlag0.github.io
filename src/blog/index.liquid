<!DOCTYPE html>
<html lang="en">
<head>
  <title>Blog - David Laganière</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#0059b3">
  <meta name="Description" content="Blog posts by David Laganière.">
  <meta charset="UTF-8">
  {% include "head.liquid" %}
</head>
<body>
  <div class="page">
    {% include "nav.liquid" %}
    <main>
      <div class="blog-header">
        <h1>Blog</h1>
      </div>
      <ul class="post-list">
        {%- for post in collections.posts -%}
          <li class="post-item">
            <a href="{{ post.url }}">
              <h2>{{ post.data.title }}</h2>
              <p class="post-date">{{ post.date | dateFormat }}</p>
              <p class="post-excerpt">{{ post.data.excerpt }}</p>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </main>
  </div>
</body>
</html>
